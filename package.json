    "@vercel/analytics": "^2.0.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.38.0",
    "motion": "^13.1.1",
    "next": "16.3.4",
    "next-mdx-remote": "^6.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
